# Copy to .env and fill in values for local development.
# NEVER commit .env to git.
#
#   cp .env.example .env

# Centrifugo (local dev)
CENTRIFUGO_HMAC_SECRET=change-me-local-secret
CENTRIFUGO_API_KEY=change-me-api-key
CENTRIFUGO_ADMIN_PASSWORD=change-me-admin-password
CENTRIFUGO_ADMIN_SECRET=change-me-admin-secret

# MongoDB
MONGODB_URI=mongodb://localhost:27017/?directConnection=true

# Redis
REDIS_HOST=localhost
REDIS_PASS=

# Identity provider JWKS endpoint used to verify incoming access tokens.
# Leave empty ONLY behind a gateway that already verified them — the api logs a
# warning on startup when it is unset.
AUTH_JWKS_URL=

# Firebase service-account JSON. Drives push on both platforms — iOS is reached
# via FCM with the APNs auth key uploaded to the Firebase console.
# Empty disables push: worker-push still drains the queue but delivers nothing.
FCM_CREDENTIALS_PATH=
